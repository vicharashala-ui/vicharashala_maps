---
import '../styles/global.css';
import themeInit from '../scripts/themeInit.raw.ts?raw';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terms of Use — Vicharashala Maps</title>
    <meta name="description" content="Terms of Use for Vicharashala Maps — acceptable use and content licensing (CC BY-NC 4.0)." />
    <link rel="canonical" href="https://vicharashalamaps.pages.dev/terms/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={themeInit.trim()}></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 max-w-2xl mx-auto p-4 sm:p-6 text-sm" style="color: var(--color-text);">
      <h1 class="text-2xl font-semibold mb-4" style="font-family: 'Sora', sans-serif;">Terms of Use</h1>
      <p class="mb-3">
        Vicharashala Maps is provided as a free educational resource, "as is," without warranty of any kind. While
        the data is compiled from government and open sources with reasonable care, accuracy is not guaranteed —
        do not rely on this site for navigation, legal boundaries, or official records.
      </p>
      <p class="mb-3">
        Educational text on this site is licensed under
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" class="underline" style="color: var(--color-accent);" rel="noopener noreferrer">CC BY-NC 4.0</a>
        — you may share and adapt it non-commercially with attribution. Underlying geographic data retains its own
        source licence (see the footer of every page for full attribution).
      </p>
      <p class="mb-3">
        You may not use this site to scrape or republish the full dataset in bulk, attempt to disrupt the service,
        or misrepresent content as your own without attribution.
      </p>
      <p>These terms may be updated as the site evolves; continued use constitutes acceptance of the current version.</p>
    </main>
    <Footer />
  </body>
</html>
