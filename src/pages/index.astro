---
import { readFileSync } from 'node:fs';
import '../styles/global.css';
import themeInit from '../scripts/themeInit.raw.ts?raw';
import MapView from '../components/Map/MapView';
import LayerControl from '../components/Map/LayerControl';
import MapControls from '../components/Map/MapControls';
import RiverDetailPanel from '../components/Panels/RiverDetailPanel';
import PAInfoPanel from '../components/Panels/PAInfoPanel';
import SearchBar from '../components/Search/SearchBar';
import BrowsePanel from '../components/Browse/BrowsePanel';
import StatePanel from '../components/Panels/StatePanel';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';

const riversIndex = JSON.parse(readFileSync('public/data/rivers-index.json', 'utf-8'));
const states = JSON.parse(readFileSync('public/data/states.json', 'utf-8'));
const basins = JSON.parse(readFileSync('public/data/basins.json', 'utf-8'));
const cities = JSON.parse(readFileSync('public/data/cities.json', 'utf-8'));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vicharashala Maps — Rivers &amp; Protected Areas of India</title>
    <meta
      name="description"
      content="A free interactive atlas of India's rivers, basins, and protected areas — national parks, wildlife sanctuaries, tiger reserves, biosphere reserves, and Ramsar sites."
    />
    <link rel="canonical" href="https://vicharashalamaps.pages.dev/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Vicharashala Maps — Rivers & Protected Areas of India" />
    <meta
      property="og:description"
      content="A free interactive atlas of India's rivers, basins, and protected areas."
    />
    <meta property="og:url" content="https://vicharashalamaps.pages.dev/" />
    <meta property="og:image" content="https://vicharashalamaps.pages.dev/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Dataset',
        name: 'Vicharashala Maps — Rivers & Protected Areas of India',
        description: "Curated dataset of India's rivers, river basins, and protected areas (national parks, wildlife sanctuaries, tiger reserves, biosphere reserves, Ramsar sites).",
        url: 'https://vicharashalamaps.pages.dev/',
        license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      })}
    />
    <link rel="preload" href="/data/search-index-primary.json" as="fetch" crossorigin="anonymous" />
    <script is:inline set:html={themeInit.trim()}></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <script is:inline type="application/json" id="core-data-rivers" set:html={JSON.stringify(riversIndex)} />
    <script is:inline type="application/json" id="core-data-states" set:html={JSON.stringify(states)} />
    <script is:inline type="application/json" id="core-data-basins" set:html={JSON.stringify(basins)} />
    <script is:inline type="application/json" id="core-data-cities" set:html={JSON.stringify(cities)} />

    <Header />

    <main class="flex-1 min-h-0 w-full relative overflow-hidden">
      <MapView client:load />
      <LayerControl client:load />
      <MapControls client:load />
      <SearchBar client:idle />
      <BrowsePanel client:load />
      <RiverDetailPanel client:load />
      <PAInfoPanel client:load />
      <StatePanel client:load />
    </main>

    <Footer />
  </body>
</html>
