---
// §8/§14 blog post page. Content rendered via the Content Layer API's render(); external links
// inside markdown get target=_blank + rel=noopener,noreferrer from astro.config.mjs's
// rehype-external-links (§5.3's "External link safety" requirement).
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';
import themeInit from '../../scripts/themeInit.raw.ts?raw';
import soraLatin600 from '@fontsource/sora/files/sora-latin-600-normal.woff2?url';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Header from '../../components/Layout/Header.astro';
import Footer from '../../components/Layout/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} | Vicharashala Maps`;
const canonical = `https://vicharashalamaps.pages.dev/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: canonical,
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={post.data.description} />
    <meta name="keywords" content={post.data.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={soraLatin600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://vicharashalamaps.pages.dev/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline set:html={themeInit.trim()}></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 max-w-2xl mx-auto p-4 sm:p-6 text-sm" style="color: var(--color-text);">
      <a href="/blog" class="inline-block mb-4 text-sm underline" style="color: var(--color-accent);">← Back to Blog</a>
      <h1 class="text-2xl font-semibold mb-1" style="font-family: 'Sora', sans-serif;">{post.data.title}</h1>
      <p class="text-xs mb-6" style="color: var(--color-text-muted);">
        {post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <div class="blog-content">
        <Content />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-content :global(h2) {
    font-family: 'Sora', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .blog-content :global(p) {
    margin-bottom: 0.75rem;
  }
  .blog-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .blog-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0.75rem;
  }
  .blog-content :global(th),
  .blog-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.375rem 0.5rem;
    text-align: left;
  }
</style>
