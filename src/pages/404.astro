---
import '../styles/global.css';
import themeInit from '../scripts/themeInit.raw.ts?raw';
import soraLatin600 from '@fontsource/sora/files/sora-latin-600-normal.woff2?url';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Vicharashala Maps</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={soraLatin600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
    <script is:inline set:html={themeInit.trim()}></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 flex flex-col items-center justify-center gap-3 text-center p-6" style="color: var(--color-text);">
      <h1 class="text-3xl font-semibold" style="font-family: 'Sora', sans-serif;">Page not found</h1>
      <p class="text-sm" style="color: var(--color-text-muted);">The page you're looking for doesn't exist.</p>
      <a href="/" class="text-sm underline" style="color: var(--color-accent);">← Back to the map</a>
    </main>
    <Footer />
  </body>
</html>
