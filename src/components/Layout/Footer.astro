---
// §6.3 footer. Hidden on mobile (<768px) — spec's mobile layout (§6.4) has no footer row, only
// header + ROTD + map/browse tabs + bottom sheet. "Sources" isn't a separate route anywhere in
// the spec, so its content (§13's licence/attribution note) is inlined directly here rather than
// linking to a page that doesn't exist. Blog link omitted: /blog doesn't exist yet (Phase 2).
const year = new Date().getFullYear();
---
<footer
  class="hidden md:flex flex-col gap-2 px-4 py-3 text-xs border-t shrink-0"
  style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-muted);"
>
  <nav class="flex flex-wrap gap-x-4 gap-y-1">
    <a href="/about" class="hover:underline">About</a>
    <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
    <a href="/terms" class="hover:underline">Terms of Use</a>
  </nav>
  <p>
    Educational content licensed CC BY-NC 4.0. State/boundary data: Government of India (Survey of India). River
    geometry: © OpenStreetMap contributors (ODbL), supplemented by HydroRIVERS © HydroSHEDS/USGS (CC-BY). Basin
    polygons: WRIS India, Ministry of Jal Shakti. Protected area boundaries: MoEFCC/WII.
  </p>
  <p>© {year} Vicharashala Maps.</p>
</footer>
