---
// §6.3/§6.4 header. Scoped to logo + nav + theme toggle only — Search stays as the existing
// floating SearchBar over the map (index.astro), not relocated here; the full desktop 3-column
// grid (docked Sidebar, Quick Stats banner, AdSense slots) is still deferred from Step 38.
---
<header
  class="flex items-center justify-between gap-4 px-4 h-14 border-b shrink-0"
  style="background: var(--color-bg); border-color: var(--color-border);"
>
  <a href="/" class="text-base font-semibold shrink-0" style="font-family: 'Sora', sans-serif; color: var(--color-text);">
    Vicharashala Maps
  </a>
  <nav class="hidden sm:flex items-center gap-4 text-sm" style="color: var(--color-text-muted);">
    <a href="/compare" class="hover:underline">Compare</a>
    <a href="/blog" class="hover:underline">Blog</a>
    <a href="/about" class="hover:underline">About</a>
  </nav>
  <button
    id="theme-toggle"
    type="button"
    aria-label="Toggle dark mode"
    class="shrink-0 h-9 w-9 rounded border flex items-center justify-center"
    style="background: var(--color-surface); border-color: var(--color-border); color: var(--color-text);"
  >
    <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" stroke-linecap="round" />
    </svg>
    <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M13.5 9.5A6 6 0 1 1 6.5 2.5a5 5 0 0 0 7 7Z" stroke-linejoin="round" />
    </svg>
  </button>
</header>

<style>
  .theme-icon-moon {
    display: none;
  }
  [data-theme='dark'] .theme-icon-sun {
    display: none;
  }
  [data-theme='dark'] .theme-icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-icon-moon {
      display: block;
    }
  }
</style>

<script>
  // Explicit override of themeInit's auto-detection (§5.6) — persists the user's choice past
  // whatever prefers-color-scheme said on first load.
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.getAttribute('data-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>
